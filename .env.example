# ---- Database (hosted MySQL) ----
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="mysql://user:password@host:3306/trade_with_lk_legist"

# ---- Auth ----
# Long random string. Generate with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="replace-me-with-a-long-random-string"

# ---- Market news (server-side only; never exposed to the browser) ----
FINNHUB_API_KEY=""

# ---- Telegram alerts for new contact-form leads (optional) ----
# Bot token from @BotFather. Chat ID of the person/group that should get alerts
# (comma-separate several IDs). Leave empty to turn alerts off.
